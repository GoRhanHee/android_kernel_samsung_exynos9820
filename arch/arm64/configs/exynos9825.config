# Disable Scamsung anti-root protection
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_RKP_KDP=n
CONFIG_RKP_NS_PROT=n
CONFIG_RKP_DMAP_PROT=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_FIVE=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n

# Import Ramdisk in boot.img
CONFIG_ANDROID_SAR_RAMDISK=y
CONFIG_ANDROID_BOOT_PARTITION="/dev/sda14"

CONFIG_KUSER_HELPERS=y
CONFIG_SYSVIPC_COMPAT=y
# CONFIG_COMPAT_VDSO is not set
CONFIG_CROSS_COMPILE_ARM32=""

# Setting Devfreq
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=666000
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=1000
CONFIG_DEVFREQ_EXYNOS_MIF_BOOST_FREQ=1594000

CONFIG_BATTERY_SAVER=y
CONFIG_BOEFFLA_WL_BLOCKER=y
CONFIG_DYNAMIC_FSYNC=y
CONFIG_POWERSUSPEND=y
# CONFIG_POWERSUSPEND_DEBUG is not set
CONFIG_STATE_NOTIFIER=y

# IOSCHED
CONFIG_IOSCHED_MAPLE=y
# CONFIG_IOSCHED_FIOPS is not set
# CONFIG_IOSCHED_SIO is not set
# CONFIG_IOSCHED_ZEN is not set
CONFIG_IOSCHED_ANXIETY=y
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_MAPLE is not set
CONFIG_DEFAULT_ANXIETY=y

CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Cpu
CONFIG_CPU_FREQ_GOV_COMMON=y
CONFIG_CPU_FREQ_GOV_BLU_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_NOBODY_SCHED=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# CONFIG_CPU_FREQ_GOV_SCHEDUTIL is not set
CONFIG_FREQVAR_TUNE=n

# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_BLU_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_NOBODY_SCHED=y

# Selinux
# CONFIG_SECURITY_SELINUX_ALWAYS_ENFORCE is not set
# CONFIG_SECURITY_SELINUX_ALWAYS_PERMISSIVE is not set

# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_DEFAULT_HTCP is not set
# CONFIG_DEFAULT_WESTWOOD is not set

# Load Module
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

CONFIG_ARM_MODCLOCK=y
CONFIG_MAX_FREQ_BIG=2400000
CONFIG_MIN_FREQ_BIG=377000
CONFIG_MAX_FREQ_LITTLE=1950000
CONFIG_MIN_FREQ_LITTLE=182000
CONFIG_MAX_FREQ_PRIME=2808000
CONFIG_MIN_FREQ_PRIME=520000

CONFIG_BOEFFLA_WL_BLOCKER=y

# Kernel LocalVersion
CONFIG_LOCALVERSION="-GoRhanHee_Kernel_S10"
CONFIG_LOCALVERSION_AUTO=n

# Isolate dtbs/dtbos
CONFIG_SOC_EXYNOS9825=y

# Enable OverlayFS
CONFIG_OVERLAY_FS=y
CONFIG_EXPORTFS=y
# CONFIG_OVERLAY_FS_REDIRECT_DIR is not set
# CONFIG_OVERLAY_FS_INDEX is not set

# Default Disabled KernelSU
CONFIG_KSU=n